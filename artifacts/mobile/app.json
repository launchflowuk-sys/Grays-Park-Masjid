{
  "expo": {
    "name": "Grays Park Masjid",
    "slug": "grays-park-masjid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "graysparkmasjid",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3D2F"
    },
    "ios": {
      "bundleIdentifier": "com.grayspark.app",
      "icon": "./assets/images/ios-icon.png",
      "buildNumber": "1",
      "deploymentTarget": "16.0",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Grays Park Masjid uses your location to find the Qibla direction.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.grayspark.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#053317"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "MODIFY_AUDIO_SETTINGS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#053317"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Grays Park Masjid uses your location to find the Qibla direction.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5d3b6a65-dbb5-43ba-99bf-9932eb98e602"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5d3b6a65-dbb5-43ba-99bf-9932eb98e602"
    }
  }
}
