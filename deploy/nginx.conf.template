server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Uploaded files (gallery photos, prayer timetable PDFs) can be up to ~25MB.
    client_max_body_size 30m;

    # Security headers. NOTE: nginx add_header is NOT inherited into any
    # location block that declares its own add_header, so these are repeated
    # in the caching locations below.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # The frontend calls same-origin relative "/api/..." paths. In Replit dev
    # this is proxied automatically by the platform's own gateway, but on any
    # other host (Coolify, etc.) nginx must do it itself, forwarding to the
    # api-server container over the internal Docker Compose network.
    #
    # Docker Compose's embedded DNS server lives at 127.0.0.11. We resolve the
    # "api-server" hostname at request time (via a variable) rather than once
    # at nginx startup, so nginx doesn't refuse to boot if api-server isn't
    # resolvable yet (e.g. still starting up, or briefly restarting).
    resolver 127.0.0.11 valid=10s;
    location /api/ {
        set $api_upstream http://api-server:8080;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # API responses must never be cached by clients. Without an explicit
        # directive, iOS/NSURLSession applies heuristic freshness and
        # revalidates using the ETag, receiving a bodyless 304 — which native
        # fetch surfaces as an empty response, breaking the app.
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    }

    # index.html must never be cached long-term: it references the current
    # set of hashed asset filenames, so a stale copy breaks deploys.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # PWA service worker: must never be cached long-term, otherwise clients
    # keep running a stale precache manifest and never pick up new deploys.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        try_files $uri =404;
    }

    # PWA registration helper emitted by vite-plugin-pwa (not content-hashed).
    location = /registerSW.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        try_files $uri =404;
    }

    # PWA web app manifest. default_type is a fallback for nginx builds whose
    # mime.types does not map the .webmanifest extension.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        try_files $uri =404;
    }

    # Vite-built assets carry a content hash in the filename, so they can be
    # cached forever. "^~" makes this prefix win over the regex block below.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        try_files $uri =404;
    }

    # Non-hashed static files (favicon, opengraph image, etc.): short cache.
    location ~* \.(?:css|js|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        try_files $uri =404;
    }
}
